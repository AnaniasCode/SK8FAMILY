// Configuração da publicação na Cloudflare (Workers com arquivos estáticos).
// A Cloudflare roda "node build.mjs" e publica a pasta dist/.
{
  "name": "sk8family",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "build": { "command": "node build.mjs" },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
